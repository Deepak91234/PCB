{
  "type": "object",
  "title": "PCBAgent circuit",
  "required": [
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "pcbagent/circuit@1"
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "ref",
          "part",
          "pins"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "[A-Z]{1,3}[0-9]{1,3}"
          },
          "part": {
            "type": "string",
            "minLength": 1,
            "description": "Part model id from pcb_models, e.g. resistor, capacitor, AMS1117-3.3, header_1x02"
          },
          "value": {
            "type": [
              "string",
              "number"
            ],
            "description": "Required for resistor/capacitor/inductor, e.g. \"10k\", \"100n\", \"4.7u\""
          },
          "package": {
            "type": "string",
            "description": "Optional package for passives: 0402, 0603, 0805, 1206"
          },
          "pins": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "[A-Z][A-Z0-9_]{0,31}"
            },
            "description": "Map of part pin name to net name, e.g. {\"IN\": \"VIN\", \"OUT\": \"VOUT\", \"GND\": \"GND\"}"
          },
          "note": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  }
}
