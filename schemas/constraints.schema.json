{
  "type": "object",
  "title": "PCBAgent placement constraints",
  "required": [
    "constraints"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "pcbagent/constraints@1"
      ]
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional board size limits. The placer picks the actual size.",
      "properties": {
        "max_width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_height_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "margin_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "align",
              "apart",
              "edge",
              "flow",
              "group",
              "near"
            ]
          },
          "ref": {
            "type": "string",
            "pattern": "[A-Z]{1,3}[0-9]{1,3}"
          },
          "to": {
            "type": "string",
            "pattern": "[A-Z]{1,3}[0-9]{1,3}"
          },
          "pin": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "[A-Z]{1,3}[0-9]{1,3}"
            },
            "minItems": 2
          },
          "max_mm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "min_mm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "side": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "top",
              "bottom",
              "any"
            ]
          },
          "axis": {
            "type": "string",
            "enum": [
              "x",
              "y"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "pour_ground": {
      "type": "boolean",
      "description": "Add ground pours on both layers (default true)."
    }
  }
}
